#!/bin/sh

# SPDX-License-Identifier: MPL-2.0

set -e

# Run one installer phase while reporting its exact lifecycle on stderr.
run_install_phase() {
    local phase="$1"
    shift
    local status=0
    # Separate markers from prompts or progress that did not end with newline.
    printf '\nCYBERMANJU_INSTALL_PHASE:begin phase=%s\n' "$phase" >&2
    "$@" || status=$?
    printf '\nCYBERMANJU_INSTALL_PHASE:end phase=%s status=%s\n' "$phase" "$status" >&2
    return "$status"
}

# Default values
CONFIG_PATH=""
DISK=""
FORCE_FORMAT_DISK=false

# Select partition paths without touching the disk. NVMe, eMMC and NBD use
# the same `p` separator as loop devices; SCSI/virtio/Xen disks do not.
set_partition_devices() {
    case "$DISK" in
        /dev/loop*|/dev/nvme*n*|/dev/mmcblk*|/dev/nbd*) partition_separator=p ;;
        *) partition_separator= ;;
    esac
    BOOT_DEVICE="${DISK}${partition_separator}1"
    ROOT_DEVICE="${DISK}${partition_separator}2"
}

# Function to display help
show_help() {
    cat << EOF
Usage:
$0 --config <CONFIG_PATH> --disk <DISK> [--force-format-disk]
$0 [-h | --help]

Options:
  --config <CONFIG_PATH>      Path to the configuration file.
  --disk <DISK>               Target disk for installation (e.g., /dev/sda).
  --force-format-disk         Forcefully format the specified disk (DANGEROUS!).
  -h, --help                  Show this help message.

Example:
  $0 --config ./distro/configuration.nix --disk /dev/vda --force-format-disk
EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config)
            if [[ -z "$2" ]] || [[ "$2" == -* ]]; then
                echo "Error: --config requires a non-empty argument." >&2
                exit 1
            fi
            CONFIG_PATH="$2"
            shift 2
            ;;
        --disk)
            if [[ -z "$2" ]] || [[ "$2" == -* ]]; then
                echo "Error: --disk requires a non-empty argument." >&2
                exit 1
            fi
            DISK="$2"
            shift 2
            ;;
        --force-format-disk)
            FORCE_FORMAT_DISK=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            show_help
            exit 1
            ;;
    esac
done

# Validate required arguments
if [[ -z "$CONFIG_PATH" ]]; then
    echo "Error: --config is required." >&2
    exit 1
fi

if [[ -z "$DISK" ]]; then
    echo "Error: --disk is required." >&2
    exit 1
fi

# When a tool below closes the disk after writing it, udevd asks the kernel
# to re-read the partition table. The re-read deletes and re-creates every
# partition device, so mkfs fails with ENOENT or ENXIO if it opens a
# partition in between, even though parted has already created it.
#
# udevd skips the re-read while another process holds a flock on the whole
# disk (https://systemd.io/BLOCK_DEVICE_LOCKING/), so hold one until both
# partitions are mounted. Open the disk read-only, because closing a
# writable fd would itself trigger a re-read.
exec 9<"${DISK}"
flock -x 9

# Confirm dangerous operation if --force-format-disk is used
if [[ "$FORCE_FORMAT_DISK" == true ]]; then
    echo "WARNING: You are about to FORMAT the disk: $DISK"
    sgdisk --zap-all $DISK
    partprobe $DISK
fi

BUILD_DIR=$(mktemp -d -p /mnt)

set_partition_devices
if [ ! -b "${BOOT_DEVICE}" ] && [ ! -b "${ROOT_DEVICE}" ]; then
    parted ${DISK} -- mklabel gpt
    parted ${DISK} -- mkpart ESP fat32 1MB 512MB
    parted ${DISK} -- mkpart root ext2 512MB 100%
    parted ${DISK} -- set 1 esp on
    echo "partition finished"

    mkfs.fat -F 32 -n boot "${BOOT_DEVICE}"
    mkfs.ext2 -L nixos "${ROOT_DEVICE}"
    echo "mkfs finished"
else
    echo "Partitions ${BOOT_DEVICE} and ${ROOT_DEVICE} already exist — skipping partitioning and mkfs"
fi

if findmnt -M ${BUILD_DIR}/boot >/dev/null; then
	umount -d ${BUILD_DIR}/boot
fi
if findmnt -M ${BUILD_DIR} >/dev/null; then
	umount -d ${BUILD_DIR}
fi

mkdir -p ${BUILD_DIR}
mount -t ext2 -o sync,dirsync "${ROOT_DEVICE}" ${BUILD_DIR}

mkdir -p ${BUILD_DIR}/boot
mkdir -p ${BUILD_DIR}/tmp
chmod 1777 ${BUILD_DIR}/tmp
mkdir -p ${BUILD_DIR}/etc/nixos
mount -o umask=077,sync,dirsync "${BOOT_DEVICE}" ${BUILD_DIR}/boot

# The kernel rejects a partition-table re-read with EBUSY while partitions
# are mounted, so the lock is no longer needed.
exec 9<&-

echo "${BUILD_DIR} is mounted successfully!"

cleanup() {
    umount -d ${BUILD_DIR}/boot 2>/dev/null || true
    umount -d ${BUILD_DIR} 2>/dev/null || true
    rm -rf ${BUILD_DIR}
}
trap cleanup EXIT INT TERM ERR

cp $CONFIG_PATH ${BUILD_DIR}/etc/nixos/configuration.nix
cp @aster-configuration@ ${BUILD_DIR}/etc/nixos/aster_configuration.nix
cp -r @aster-etc-nixos@/modules ${BUILD_DIR}/etc/nixos
cp -r @aster-etc-nixos@/overlays ${BUILD_DIR}/etc/nixos

COMMON_NIX_ARGS=(
    --option extra-substituters "@aster-substituters@"
    --option extra-trusted-public-keys "@aster-trusted-public-keys@"
)

NIX_SYSTEM="@aster-target-platform@"
NIXPKGS_PATH="@aster-nixpkgs@"

# Pre-build the NixOS system closure on the host
# so that the result is cached in the host's Nix store.
# Without this, nixos-install would build the system inside the (possibly empty) target image,
# causing redundant downloads after every `make clean`.
#
# See: https://www.mankier.com/8/nixos-install#--system
SYSTEM_CLOSURE=$(run_install_phase build-system nix-build "${NIXPKGS_PATH}/nixos" -A system \
    --option extra-platforms "${NIX_SYSTEM}" \
    --argstr system "${NIX_SYSTEM}" \
    -I "nixos-config=${BUILD_DIR}/etc/nixos/configuration.nix" \
    "${COMMON_NIX_ARGS[@]}" \
    --no-out-link)

export PATH=${PATH}:/run/current-system/sw/bin
run_install_phase install-system nixos-install --root ${BUILD_DIR} --no-root-passwd \
    --system "${SYSTEM_CLOSURE}" \
    "${COMMON_NIX_ARGS[@]}"

# Retain only the current system generation. Reusing the disk image otherwise
# preserves old system closures in its Nix store after every installation.
echo "Pruning obsolete installed system generations..."
run_install_phase prune-generations nix-env --store "${BUILD_DIR}" \
    -p "${BUILD_DIR}/nix/var/nix/profiles/system" \
    --delete-generations old
echo "Collecting unreachable paths from the installed Nix store..."
run_install_phase collect-garbage nix-store --store "${BUILD_DIR}" --gc
echo "Congratulations! Asterinas NixOS has been installed successfully!"
