+    #[tokio::test]
+    async fn dropping_receiver_releases_inotify_descriptor() {
+        let dir = TempDir::new();
+        let path = dir.path().join("appearance.toml");
+        fs::write(&path, b"initial").unwrap();
+        let before = inotify_fd_count();
