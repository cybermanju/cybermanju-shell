   201        all_test_cases
   202    };
   203
   204    if let Some(ref filter) = test_filter {
   205        println!("=== Running single test case: {} ===", filter);
   206    } else {
   207        println!("=== Found {} test case(s) ===", test_cases.len());
   208        for tc in &test_cases {
   209            println!("  - {}", tc.name);
   210        }
   211        println!();
   212    }
   213
   214    let mut session = rexpect::spawn(&qemu_cmd, Some(timeout_ms)).map_err(
Error::from)?;
   215
   216    println!("--> Waiting for login prompt...");
   217    let init_prompt = "root@asterinas:";
   218    session.exp_string(init_prompt).map_err(Error::from)?;
   219
   220    let desc = SessionDesc::new(init_prompt, "", "poweroff");
   221    let mut session = Session::new(desc, session);
   222    // `emacs` and `vi` are the two line-editing modes of Bash. Turn both 
off,
   223    // because the line editor wraps a long echoed command line at the ter
minal width
   224    // and `Session` would then fail to match it against the command it se
nt.
   225    session.run_cmd("set +o emacs +o vi")?;
   226
   227    let mut passed = 0;
   228    let mut failed = 0;
   229    let mut failed_tests = Vec::new();
   230
   231    for test_case in test_cases {
   232        println!("=== Running test case: {} ===", test_case.name);
   233
   234        match (test_case.test_fn)(&mut session) {
   235            Ok(_) => {
   236                println!("✓ Test case '{}' passed\n", test_case.name);
   237                passed += 1;
   238            }
   239            Err(_) => {
   240                println!("✗ Test case '{}' failed\n", test_case.name);
   241                failed += 1;
   242                failed_tests.push(test_case.name);
   243            }
   244        }
   245    }
   246
   247    println!("=== Test Summary ===");
   248    println!("Passed: {}", passed);
   249    println!("Failed: {}", failed);
   250
   251    let res = if !failed_tests.is_empty() {
   252        println!("\nFailed tests:");
   253        for name in failed_tests {
   254            println!("  - {}", name);
   255        }
   256
   257        Err("Some tests failed")
   258    } else {
   259        Ok(())
   260    };
   261
   262    let shutdown_res = session.shutdown();
   263
   264    res?;
   265    shutdown_res?;
   266
   267    Ok(())
   268}
