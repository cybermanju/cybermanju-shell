    12ASTERINAS_DIR=$(realpath ${SCRIPT_DIR}/../..)
    13ASTER_IMAGE_PATH=${ASTERINAS_DIR}/target/nixos/asterinas.img
    14NIXOS_DISK_SIZE_IN_MB=${NIXOS_DISK_SIZE_IN_MB:-16384}
    15DISTRO_DIR=$(realpath ${ASTERINAS_DIR}/distro)
    16CONFIG_PATH=${DISTRO_DIR}/etc_nixos/${CONFIG_FILE_NAME}
    17
    18NIX_SYSTEM=$("${SCRIPT_DIR}/print_target_nix_system.sh" "${TARGET_ARCH}") 
|| exit 1
    19
    20pushd $DISTRO_DIR
    21nix-build aster_nixos_installer/default.nix \
    22    --argstr target_platform "${NIX_SYSTEM}" \
    23    --argstr disable-systemd "${NIXOS_DISABLE_SYSTEMD}" \
    24    --argstr stage-2-hook "${NIXOS_STAGE_2_INIT}" \
    25    --argstr log-level "${LOG_LEVEL}" \
    26    --argstr console "${CONSOLE}" \
    27    --argstr extra-substituters "${RELEASE_SUBSTITUTER} ${DEV_SUBSTITUTER}
" \
    28    --argstr extra-trusted-public-keys "${RELEASE_TRUSTED_PUBLIC_KEY} ${DE
V_TRUSTED_PUBLIC_KEY}"
    29popd
    30
    31mkdir -p ${ASTERINAS_DIR}/target/nixos
    32# The installer skips partitioning and mkfs on an existing image,
    33# so a new size takes effect only on a new image.
    34if [ -e ${ASTER_IMAGE_PATH} ] \
    35    && [ "$(stat -c %s ${ASTER_IMAGE_PATH})" -ne $((NIXOS_DISK_SIZE_IN_MB 
* 1024 * 1024)) ]; then
    36    echo "Removing ${ASTER_IMAGE_PATH}, because its size is not ${NIXOS_DI
SK_SIZE_IN_MB}MB......"
    37    rm ${ASTER_IMAGE_PATH}
    38fi
    39if [ ! -e ${ASTER_IMAGE_PATH} ]; then
    40    echo "Creating image at ${ASTER_IMAGE_PATH} of size ${NIXOS_DISK_SIZE_
IN_MB}MB......"
    41    fallocate -l ${NIXOS_DISK_SIZE_IN_MB}M ${ASTER_IMAGE_PATH}
    42    echo "Image created successfully!"
    43fi
    44
    45DISK=$(losetup -fP --show ${ASTER_IMAGE_PATH})
    46cleanup() {
    47    losetup -d ${DISK} 2>/dev/null || true
    48}
    49trap cleanup EXIT INT TERM ERR
    50
    51${DISTRO_DIR}/result/bin/aster-nixos-install --config ${CONFIG_PATH} --dis
k ${DISK}
