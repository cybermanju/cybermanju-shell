lect();
   183
   184    if all_test_cases.is_empty() {
   185        return Err("No test cases found".into());
   186    }
   187
   188    // Filter test cases if --test is specified
   189    let test_cases: Vec<&TestCase> = if let Some(ref filter) = test_filter
 {
   190        let filtered: Vec<&TestCase> = all_test_cases
   191            .into_iter()
   192            .filter(|tc| tc.name == filter)
   193            .collect();
   194
