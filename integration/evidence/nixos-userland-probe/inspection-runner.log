   137    pub fn run_cmd_and_expect(&mut self, command: &str, expected: &str) ->
 Result<(), Error> {
   138        println!("--> Running: {} (expecting: {})", command, expected);
   139        self.pty_session.send_line(command).map_err(Error::from)?;
   140        // Read and consume the echoed command line
   141        self.pty_session.exp_string(command).map_err(Error::from)?;
   142
   143        match self
   144            .pty_session
   145            .exp_string(&self.desc.prompt)
   146            .map_err(Error::from)
   147        {
   148            Ok(unread) => {
   149                let cleaned_unread = clean_output(&unread);
   150                if !cleaned_unread.contains(expected) {
   151                    let error = Error::UnexpectedOutput {
   152                        expected: expected.to_string(),
   153                        got: truncate_output_for_error(&cleaned_unread),
   154                    };
   155                    Self::output_error(&error);
   156                    return Err(error);
   157                }
   158            }
   159            Err(e) => {
   160                Self::output_error(&e);
   161                return Err(e);
   162            }
   163        }
   164
   165        Ok(())
   166    }
