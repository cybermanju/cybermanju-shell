+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{ServiceStatus, lifecycle::ServiceMode};
+
+    #[test]
+    fn missing_pulse_socket_sets_lifecycle_error_without_panicking() {
+        let lifecycle = Lifecycle::new(ServiceMode::Eager);
+        let token = lifecycle.begin();
+        let socket = format!(
+            "unix:/tmp/gpuishell-pulse-missing-{}-{}.sock",
+            std::process::id(),
+            thread::current().name().unwrap_or("test")
+        );
+
+        start_listener_with_server(Mutable::new(AudioData::default()), token, Some(socket));
+
+        // The listener reports connection startup failures asynchronously.
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        loop {
+            if matches!(lifecycle.status(), ServiceStatus::Error(_)) {
+                break;
+            }
+            assert!(
+                std::time::Instant::now() < deadline,
+                "listener did not report the missing PulseAudio socket"
+            );
+            thread::sleep(std::time::Duration::from_millis(10));
+        }
+        assert!(matches!(lifecycle.status(), ServiceStatus::Error(_)));
+    }
+}
