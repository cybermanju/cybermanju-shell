+// SPDX-License-Identifier: MPL-2.0
+/* Host-only tests: cc this with diagnostics_format.c and NVIDIA include roots. */
+#include <nvtypes.h>
+#include <os-interface.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+int aster_nv_snprintf(char *buffer, NvU32 capacity, const char *fmt, ...);
+int nv_printf(NvU32 level, const char *fmt, ...);
+
+static char logged[2048];
+static NvU32 logged_length;
+
+void aster_nv_log_bytes(const char *bytes, NvU32 length)
+{
+    logged_length = length < sizeof(logged) ? length : (NvU32)sizeof(logged);
+    memcpy(logged, bytes, logged_length);
+    (void)fwrite(bytes, 1, length, stderr);
+    (void)fputc('\n', stderr);
+}
+
+static int failures;
+#define CHECK(condition) do { \
+    if (!(condition)) { \
+        fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #condition); \
+        ++failures; \
+    } \
+} while (0)
+
+#define COMPARE(format, ...) do { \
+    char expected[512], actual[512]; \
+    int er = snprintf(expected, sizeof(expected), format, ##__VA_ARGS__); \
+    int ar = aster_nv_snprintf(actual, sizeof(actual), format, ##__VA_ARGS__); \
+    if (er != ar || (er >= 0 && strcmp(expected, actual) != 0)) { \
+        fprintf(stderr, "format mismatch [%s]: libc=%d <%s>, ours=%d <%s>\n", \
+                format, er, expected, ar, actual); \
+        ++failures; \
+    } \
+} while (0)
+
+int main(void)
+{
+    char a[64], b[64], big[1400], exact[1024];
+    int n = 77;
+    int r;
+
+    COMPARE("signed=%d unsigned=%u", -123, 4000000000U);
+    COMPARE("oct=%#o hex=%#x HEX=%#X", 0755U, 0xfeedU, 0xfeedU);
+    COMPARE("sign=[%+08d][% 6i]", -42, 42);
+    COMPARE("precision=[%#.0o][%.0u][%08.4x]", 0U, 0U, 0x2aU);
+    COMPARE("left=[%-9d] width=[%*u]", 12, -8, 31U);
+    COMPARE("string=[%-8.3s] char=[%4c] %%", "abcdef", 'Q');
+    COMPARE("hh=%hhd h=%hd l=%ld ll=%lld", (int)-7, (int)-1234, (long)-7654321,
+            (long long)-1234567890123LL);
+    COMPARE("hh=%hhu h=%hu z=%zu t=%td j=%jd", (int)250, (int)60000,
+            (size_t)123456, (ptrdiff_t)-9876, (intmax_t)-1234567890123LL);
+    COMPARE("hex=%llx upper=%#llX", (unsigned long long)0x123456789abcdef0ULL,
+            (unsigned long long)0xabcdeULL);
+    COMPARE("p=%p nullstr=%.0s", (void *)&n, "ignored");
+    COMPARE("[%05%]");
+
+    /* libc-compatible truncation and NUL termination, including size one. */
+    memset(a, 'x', sizeof(a)); memset(b, 'x', sizeof(b));
+    r = snprintf(a, 5, "%s", "abcdefgh");
+    CHECK(r == aster_nv_snprintf(b, 5, "%s", "abcdefgh"));
+    CHECK(strcmp(a, b) == 0 && b[4] == '\0');
+    CHECK(aster_nv_snprintf(b, 1, "abc") == 3 && b[0] == '\0');
+    CHECK(aster_nv_snprintf(NULL, 0, "%#x", 255U) == snprintf(NULL, 0, "%#x", 255U));
+    CHECK(aster_nv_snprintf(NULL, 1, "x") == -1);
+
+    /* Unsupported directives and pathological sizes fail closed. */
+    CHECK(aster_nv_snprintf(b, sizeof(b), "bad %f", 1.0) == -1);
+    CHECK(aster_nv_snprintf(b, sizeof(b), "bad %n", &n) == -1 && n == 77);
+    CHECK(aster_nv_snprintf(b, sizeof(b), "%2147483647d", 1) == -1);
+    CHECK(aster_nv_snprintf(b, sizeof(b), "%*d", 1048577, 1) == -1);
+    CHECK(aster_nv_snprintf(b, sizeof(b), "%.*s", -1, "abc") == 3);
+
+    memset(big, 'A', sizeof(big)); big[sizeof(big) - 1] = '\0';
+    logged_length = 0;
+    CHECK(nv_printf(3, "prefix:%s", big) == (int)(sizeof(big) + 6));
+    CHECK(logged_length == 1023);
+    CHECK(memcmp(logged + 1009, "...[truncated]", 14) == 0);
+    CHECK(logged[logged_length - 1] == ']');
+    memset(exact, 'B', sizeof(exact) - 1); exact[sizeof(exact) - 1] = '\0';
+    logged_length = 0;
+    CHECK(nv_printf(3, "%s", exact) == 1023);
+    CHECK(logged_length == 1023 && logged[1022] == 'B');
+    CHECK(memcmp(logged + 1009, "...[truncated]", 14) != 0);
+    logged_length = 0;
+    CHECK(nv_printf(1, "unsupported %f", 2.0) == -1);
+    CHECK(logged_length == strlen("nvidia-nvport: <formatting failed>"));
+    CHECK(memcmp(logged, "nvidia-nvport: <formatting failed>", logged_length) == 0);
+
+    if (failures) {
+        fprintf(stderr, "%d formatter test(s) failed\n", failures);
+        return 1;
+    }
+    puts("diagnostics formatter tests passed");
+    return 0;
+}
diff --git a/ostd/libs/nvidia-nvport/firmware_bridge.c b/ostd/libs/nvidia-nvport/firmware_bridge.c
new file mode 100644
--- /dev/null
+++ b/ostd/libs/nvidia-nvport/firmware_bridge.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: MIT */
+/* No firmware filename table is reimplemented here. */
+#include <nvUnixVersion.h>
+#define NV_FIRMWARE_FOR_NAME(name) "nvidia/" NV_VERSION_STRING "/" name ".bin"
+#include <nv-firmware.h>
+#include <nv.h>
+
+_Static_assert(sizeof(nv_firmware_type_t) == 4, "firmware kind ABI");
+_Static_assert(sizeof(nv_firmware_chip_family_t) == 4, "firmware family ABI");
+_Static_assert(NV_FIRMWARE_TYPE_GSP == 0 && NV_FIRMWARE_TYPE_GSP_LOG == 1 &&
+               NV_FIRMWARE_TYPE_UCODES == 2, "non-VMware firmware kind ABI");
+
+_Static_assert(NV_FIRMWARE_CHIP_FAMILY_TU10X == 1 &&
+               NV_FIRMWARE_CHIP_FAMILY_TU11X == 2 &&
+               NV_FIRMWARE_CHIP_FAMILY_GA100 == 3 &&
+               NV_FIRMWARE_CHIP_FAMILY_GA10X == 4 &&
+               NV_FIRMWARE_CHIP_FAMILY_AD10X == 5 &&
+               NV_FIRMWARE_CHIP_FAMILY_GH100 == 6 &&
+               NV_FIRMWARE_CHIP_FAMILY_GB10X == 8 &&
+               NV_FIRMWARE_CHIP_FAMILY_GB20X == 9 &&
+               NV_FIRMWARE_CHIP_FAMILY_GR10X == 10 &&
+               NV_FIRMWARE_CHIP_FAMILY_GB10Y == 11 &&
+               NV_FIRMWARE_CHIP_FAMILY_GB20Y == 12, "firmware family discriminants");
+
+const char *aster_nv_firmware_path(NvU32 kind, NvU32 family)
+{
+    if (kind > NV_FIRMWARE_TYPE_UCODES || family == 0 || family == 7 ||
+        family >= NV_FIRMWARE_CHIP_FAMILY_END)
+        return "";
+    return nv_firmware_for_chip_family((nv_firmware_type_t)kind,
+                                       (nv_firmware_chip_family_t)family);
+}
+
+/* Real C-to-Rust ABI round trip used by the safe owning wrapper. The port's
+ * provider deliberately does not require a Linux nv_linux_state_t. */
+const void *aster_nv_firmware_acquire(NvU32 kind, NvU32 family,
+                                     const void **buffer, NvU32 *size)
+{
+    return nv_get_firmware(NULL, (nv_firmware_type_t)kind,
+                          (nv_firmware_chip_family_t)family, buffer, size);
+}
+
+void aster_nv_firmware_release(const void *handle)
+{
+    nv_put_firmware(handle);
+}
+
+/* Type validation against the real RM ABI declarations. */
+void aster_nv_firmware_abi_probe(void)
+{
+    const void *(NV_API_CALL *get)(nv_state_t *, nv_firmware_type_t,
+        nv_firmware_chip_family_t, const void **, NvU32 *) = &nv_get_firmware;
+    void (NV_API_CALL *put)(const void *) = &nv_put_firmware;
+    (void)get;
+    (void)put;
+}
diff --git a/ostd/libs/nvidia-nvport/src/diagnostics.rs b/ostd/libs/nvidia-nvport/src/diagnostics.rs
new file mode 100644
--- /dev/null
+++ b/ostd/libs/nvidia-nvport/src/diagnostics.rs
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Bounded diagnostics for the unmodified NVIDIA Unix-kernel NVport sources.
+
+use core::ffi::c_char;
+
+/// Maximum number of input bytes read from an NVIDIA diagnostic C string.
+const MAX_C_STRING_BYTES: usize = 256;
+
+/// Sink for fully formatted diagnostics. It never interprets format strings.
+///
+/// # Safety
+/// A nonzero `length` requires that many immutable readable bytes at `message`.
+/// The C formatter's fixed output budget is 1024 bytes; larger lengths halt.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn aster_nv_log_bytes(message: *const c_char, length: u32) {
+    assert!(
+        length <= 1024,
+        "NVIDIA formatted log exceeds its ABI budget"
+    );
+    assert!(
+        !message.is_null() || length == 0,
+        "NVIDIA formatted log has a null pointer"
+    );
+    let bytes = if length == 0 {
+        &[][..]
+    } else {
+        // SAFETY: Caller guarantees this bounded immutable readable range.
+        unsafe { core::slice::from_raw_parts(message.cast::<u8>(), length as usize) }
+    };
+    if let Ok(text) = core::str::from_utf8(bytes) {
+        ostd::early_println!("nvidia-nvport: {}", text);
+    } else {
+        ostd::early_print!("nvidia-nvport: <C bytes ");
+        for byte in bytes {
+            ostd::early_print!("\\x{byte:02x}");
+        }
+        ostd::early_println!(">");
+    }
+}
+
+/// Logs a bounded C string from NVIDIA's `out_string` callback.
+///
+/// The callback contract requires `message` to point to a readable NUL-terminated
+/// C string. To keep accidental unterminated strings bounded, at most 256 bytes
+/// are read and the log explicitly marks truncation. Valid UTF-8 is printed as
+/// text; other byte sequences are escaped losslessly as `\\xNN` bytes.
+///
+/// # Safety
+/// `message` must be non-null and point to readable memory through its NUL
+/// terminator, or through at least 256 readable bytes if there is no terminator
+/// within that bound.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn out_string(message: *const c_char) {
+    if message.is_null() {
+        ostd::early_println!("nvidia-nvport: out_string(<null>)");
+        return;
+    }
+
+    let mut len = 0;
+    let mut terminated = false;
+    while len < MAX_C_STRING_BYTES {
+        // SAFETY: The callback contract guarantees readable bytes through the
+        // terminator, or at least MAX_C_STRING_BYTES bytes for a bounded string.
+        let byte = unsafe { message.cast::<u8>().add(len).read() };
+        if byte == 0 {
+            terminated = true;
+            break;
+        }
+        len += 1;
+    }
+
+    // SAFETY: Every byte in this bounded range was just read under the pointer
+    // validity contract, and the immutable C string remains readable for the call.
+    let bytes = unsafe { core::slice::from_raw_parts(message.cast::<u8>(), len) };
+    match core::str::from_utf8(bytes) {
+        Ok(text) if terminated => ostd::early_println!("nvidia-nvport: {}", text),
+        Ok(text) => ostd::early_println!(
+            "nvidia-nvport: {} [truncated after {} bytes]",
+            text,
+            MAX_C_STRING_BYTES
+        ),
+        Err(_) => {
+            // Hex-escape every byte without allocation. This preserves arbitrary
+            // C-string bytes in a printable, fixed-size diagnostic.
+            const HEX: &[u8; 16] = b"0123456789abcdef";
+            let mut escaped = [0u8; MAX_C_STRING_BYTES * 4];
+            for (index, &byte) in bytes.iter().enumerate() {
+                let offset = index * 4;
+                escaped[offset..offset + 4].copy_from_slice(&[
+                    b'\\',
+                    b'x',
+                    HEX[(byte >> 4) as usize],
+                    HEX[(byte & 0x0f) as usize],
+                ]);
+            }
+            // SAFETY: The escaped buffer consists exclusively of ASCII bytes.
+            let escaped = unsafe { core::str::from_utf8_unchecked(&escaped[..len * 4]) };
+            if terminated {
+                ostd::early_println!("nvidia-nvport: <C bytes {}>", escaped);
+            } else {
+                ostd::early_println!(
+                    "nvidia-nvport: <C bytes {}> [truncated after {} bytes]",
+                    escaped,
+                    MAX_C_STRING_BYTES
+                );
+            }
+        }
+    }
+}
+
+/// Fails closed when NVIDIA requests a debug breakpoint.
+///
+/// This is intentionally not a no-op: reaching a breakpoint in the unmodified
+/// NVport code is treated as a kernel-fatal invariant/debug failure.
+#[unsafe(no_mangle)]
+pub(crate) extern "C" fn os_dbg_breakpoint() -> ! {
+    panic!("nvidia-nvport: upstream requested os_dbg_breakpoint");
+}
+
+#[cfg(ktest)]
+mod tests {
+    use core::ffi::{c_char, c_int};
+    unsafe extern "C" {
+        fn aster_nv_snprintf(
+            buffer: *mut c_char,
+            capacity: u32,
+            format: *const c_char,
+            ...
+        ) -> c_int;
+        fn nv_printf(level: u32, format: *const c_char, ...) -> c_int;
+    }
+
+    #[ostd::prelude::ktest]
+    fn actual_freestanding_formatter_through_c_abi() {
+        let mut bytes = [0u8; 128];
+        // SAFETY: Buffer and C strings are valid; variadic arguments exactly
+        // match the format's promoted C integer/pointer types on x86-64.
+        let count = unsafe {
+            aster_nv_snprintf(
+                bytes.as_mut_ptr().cast(),
+                bytes.len() as u32,
+                c"%#08x|%+lld|%.3s|%zu|%%".as_ptr(),
+                42u32,
+                7i64,
+                c"abcdef".as_ptr(),
+                12usize,
+            )
+        };
+        let expected = b"0x00002a|+7|abc|12|%";
+        assert_eq!(count as usize, expected.len());
+        assert_eq!(&bytes[..expected.len()], expected);
+        assert_eq!(bytes[expected.len()], 0);
+        let mut short = [0u8; 5];
+        let count =
+            unsafe { aster_nv_snprintf(short.as_mut_ptr().cast(), 5, c"%u".as_ptr(), 123456u32) };
+        assert_eq!(count, 6);
+        assert_eq!(&short, b"1234\0");
+        let mut untouched = 77i32;
+        let count = unsafe {
+            aster_nv_snprintf(
+                bytes.as_mut_ptr().cast(),
+                128,
+                c"%n".as_ptr(),
+                &mut untouched as *mut i32,
+            )
+        };
+        assert_eq!(count, -1);
+        assert_eq!(untouched, 77);
+        let count = unsafe {
+            nv_printf(
+                u32::MAX,
+                c"native formatter CPU-only check=%u".as_ptr(),
+                17u32,
+            )
+        };
+        assert_eq!(count as usize, b"native formatter CPU-only check=17".len());
+    }
+}
diff --git a/ostd/libs/nvidia-nvport/src/firmware.rs b/ostd/libs/nvidia-nvport/src/firmware.rs
new file mode 100644
--- /dev/null
+++ b/ostd/libs/nvidia-nvport/src/firmware.rs
@@ -0,0 +1,619 @@
+// SPDX-License-Identifier: MPL-2.0
+//! NVIDIA RM firmware ownership backed by an immutable boot `newc` archive.
+//!
+//! This implements file acquisition/release, not firmware authentication, GSP
+//! loading, DMA, or a GPU boot handshake. Only NVIDIA's release-pinned filename
+//! selector chooses paths; symlinks, duplicates, malformed and compressed archives
+//! fail closed. Firmware bytes remain pinned by the boot archive's static lifetime.
+
+use alloc::alloc::{alloc, dealloc};
+use core::{
+    alloc::Layout,
+    ffi::{CStr, c_char, c_void},
+    ptr,
+};
+
+use spin::Once;
+
+/// Firmware release required by the linked NVIDIA source.
+pub const RELEASE: &str = "615.78.08";
+/// Maximum accepted individual firmware payload (128 MiB), not an allocation size.
+pub const MAX_FIRMWARE_SIZE: usize = 128 * 1024 * 1024;
+
+/// NVIDIA's firmware image kinds, excluding the VMware-only bindata variant.
+#[repr(u32)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FirmwareKind {
+    /// GSP-RM image.
+    Gsp = 0,
+    /// Optional GSP log symbols.
+    GspLog = 1,
+    /// Companion microcode image.
+    Ucodes = 2,
+}
+
+/// Families recognized by the exact upstream release's filename selector.
+#[repr(u32)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ChipFamily {
+    /// Turing TU10x.
+    Tu10x = 1,
+    /// Turing TU11x.
+    Tu11x = 2,
+    /// Ampere GA100.
+    Ga100 = 3,
+    /// Ampere GA10x.
+    Ga10x = 4,
+    /// Ada AD10x.
+    Ad10x = 5,
+    /// Hopper GH100.
+    Gh100 = 6,
+    /// Blackwell GB10x.
+    Gb10x = 8,
+    /// Blackwell GB20x.
+    Gb20x = 9,
+    /// GR10x.
+    Gr10x = 10,
+    /// GB10y.
+    Gb10y = 11,
+    /// GB20y.
+    Gb20y = 12,
+}
+
+/// Firmware retrieval failures; none indicates a running GSP or GPU.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FirmwareError {
+    /// Only uncompressed, non-CRC `newc` archives are accepted by this provider.
+    UnsupportedArchive,
+    /// A header, filename, size, padding or trailer is invalid or truncated.
+    MalformedArchive,
+    /// The requested release-specific regular file is absent.
+    NotFound,
+    /// More than one archive entry resolves to the requested path.
+    Duplicate,
+    /// A matching entry is not a standalone regular file (no symlink/hardlink following).
+    NotRegularFile,
+    /// The image is empty or exceeds the provider's explicit size limit.
+    InvalidSize,
+    /// Another boot archive was already installed.
+    AlreadyInstalled,
+    /// No immutable boot archive has been registered.
+    NotInitialized,
+    /// The real handle allocation failed.
+    NoMemory,
+    /// Firmware acquisition cannot run in interrupt context.
+    InvalidContext,
+    /// The FFI provider returned bytes inconsistent with the registered image.
+    ContractViolation,
+}
+
+unsafe extern "C" {
+    fn aster_nv_firmware_path(kind: u32, family: u32) -> *const c_char;
+    fn aster_nv_firmware_acquire(
+        kind: u32,
+        family: u32,
+        buffer: *mut *const c_void,
+        size: *mut u32,
+    ) -> *const c_void;
+    fn aster_nv_firmware_release(handle: *const c_void);
+}
+
+/// Returns NVIDIA's own exact, relative `/lib/firmware` filename for this release.
+pub fn filename(kind: FirmwareKind, family: ChipFamily) -> &'static str {
+    // SAFETY: The C bridge calls the reviewed static-inline upstream selector
+    // with valid enum values and returns an immutable, NUL-terminated literal.
+    let path = unsafe { aster_nv_firmware_path(kind as u32, family as u32) };
+    // SAFETY: The bridge's result is a static C string for every input.
+    unsafe { CStr::from_ptr(path) }
+        .to_str()
+        .expect("upstream firmware path is ASCII")
+}
+
+#[derive(Clone, Copy)]
+struct Entry<'a> {
+    name: &'a str,
+    data: &'a [u8],
+    mode: u32,
+    links: u32,
+}
+
+/// A fully bounds-checked, borrowed `newc` archive. No file data is copied.
+pub struct FirmwareArchive<'a> {
+    bytes: &'a [u8],
+}
+
+fn hex(bytes: &[u8], offset: usize) -> Result<u32, FirmwareError> {
+    let field = bytes
+        .get(offset..offset + 8)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    if !field.iter().all(u8::is_ascii_hexdigit) {
+        return Err(FirmwareError::MalformedArchive);
+    }
+    let text = core::str::from_utf8(field).map_err(|_| FirmwareError::MalformedArchive)?;
+    u32::from_str_radix(text, 16).map_err(|_| FirmwareError::MalformedArchive)
+}
+
+fn align4(value: usize) -> Result<usize, FirmwareError> {
+    value
+        .checked_add(3)
+        .map(|value| value & !3)
+        .ok_or(FirmwareError::MalformedArchive)
+}
+
+fn next_entry<'a>(bytes: &'a [u8], cursor: &mut usize) -> Result<Entry<'a>, FirmwareError> {
+    let start = *cursor;
+    let header_end = start
+        .checked_add(110)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    let header = bytes
+        .get(start..header_end)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    if &header[..6] != b"070701" {
+        return Err(FirmwareError::UnsupportedArchive);
+    }
+    // Validate *all* header fields, not just those needed for a lookup.
+    for offset in (6..110).step_by(8) {
+        hex(header, offset)?;
+    }
+    if hex(header, 102)? != 0 {
+        return Err(FirmwareError::MalformedArchive);
+    }
+    let name_len = hex(header, 94)? as usize;
+    if name_len == 0 || name_len > 4096 {
+        return Err(FirmwareError::MalformedArchive);
+    }
+    let name_end = header_end
+        .checked_add(name_len)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    let name = bytes
+        .get(header_end..name_end)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    let name = CStr::from_bytes_with_nul(name).map_err(|_| FirmwareError::MalformedArchive)?;
+    let name = name.to_str().map_err(|_| FirmwareError::MalformedArchive)?;
+    let data_start = align4(name_end)?;
+    let size = hex(header, 54)? as usize;
+    let data_end = data_start
+        .checked_add(size)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    let end = align4(data_end)?;
+    let data = bytes
+        .get(data_start..data_end)
+        .ok_or(FirmwareError::MalformedArchive)?;
+    if end > bytes.len() {
+        return Err(FirmwareError::MalformedArchive);
+    }
+    *cursor = end;
+    Ok(Entry {
+        name,
+        data,
+        mode: hex(header, 14)?,
+        links: hex(header, 38)?,
+    })
+}
+
+fn canonical_name(mut name: &str) -> Option<&str> {
+    // Accept the conventional './' or '/' archive prefix, but never resolve
+    // traversal, repeated separators or interior dot components.
+    name = name.strip_prefix('/').unwrap_or(name);
+    name = name.strip_prefix("./").unwrap_or(name);
+    if name.is_empty()
+        || name
+            .split('/')
+            .any(|part| part.is_empty() || part == "." || part == "..")
+    {
+        return None;
+    }
+    Some(name)
+}
+
+impl<'a> FirmwareArchive<'a> {
+    /// Validates the entire archive before it can supply firmware. Nonzero
+    /// trailing data, missing trailer and truncated unrelated entries are errors.
+    pub fn new(bytes: &'a [u8]) -> Result<Self, FirmwareError> {
+        if !bytes.starts_with(b"070701") {
+            return Err(FirmwareError::UnsupportedArchive);
+        }
+        let mut cursor = 0;
+        loop {
+            let entry = next_entry(bytes, &mut cursor)?;
+            if entry.name == "TRAILER!!!" {
+                if !entry.data.is_empty() || bytes[cursor..].iter().any(|&byte| byte != 0) {
+                    return Err(FirmwareError::MalformedArchive);
+                }
+                return Ok(Self { bytes });
+            }
+        }
+    }
+
+    /// Borrows an exact release-specific image. This does not validate its
+    /// vendor signature or internal image format; the real RM must do that.
+    pub fn get(&self, kind: FirmwareKind, family: ChipFamily) -> Result<&'a [u8], FirmwareError> {
+        self.get_path(filename(kind, family))
+    }
+
+    fn get_path(&self, relative: &str) -> Result<&'a [u8], FirmwareError> {
+        let mut cursor = 0;
+        let mut found = None;
+        loop {
+            let entry = next_entry(self.bytes, &mut cursor)?;
+            if entry.name == "TRAILER!!!" {
+                return found.ok_or(FirmwareError::NotFound);
+            }
+            let Some(name) = canonical_name(entry.name) else {
+                continue;
+            };
+            let Some(name) = name.strip_prefix("lib/firmware/") else {
+                continue;
+            };
+            if name != relative {
+                continue;
+            }
+            if found.is_some() {
+                return Err(FirmwareError::Duplicate);
+            }
+            if entry.mode & 0o170000 != 0o100000 || entry.links != 1 {
+                return Err(FirmwareError::NotRegularFile);
+            }
+            if entry.data.is_empty() || entry.data.len() > MAX_FIRMWARE_SIZE {
+                return Err(FirmwareError::InvalidSize);
+            }
+            found = Some(entry.data);
+        }
+    }
+}
+
+static ARCHIVE: Once<FirmwareArchive<'static>> = Once::new();
+
+/// Registers real immutable boot archive storage once. Re-registering the exact
+/// same slice is idempotent; a different source is rejected, including races.
+/// This accepts neither host files nor a fabricated GPU-success callback.
+pub fn install_boot_archive(bytes: &'static [u8]) -> Result<(), FirmwareError> {
+    let archive = FirmwareArchive::new(bytes)?;
+    let installed = ARCHIVE.call_once(|| archive);
+    if installed.bytes.as_ptr() != bytes.as_ptr() || installed.bytes.len() != bytes.len() {
+        return Err(FirmwareError::AlreadyInstalled);
+    }
+    Ok(())
+}
+
+/// Retrieves a borrowed image from the registered boot archive.
+pub fn image(kind: FirmwareKind, family: ChipFamily) -> Result<&'static [u8], FirmwareError> {
+    ARCHIVE
+        .get()
+        .ok_or(FirmwareError::NotInitialized)?
+        .get(kind, family)
+}
+
+/// An owning lease acquired through the actual RM firmware ABI. The handle
+/// cannot be duplicated or manually released by safe callers.
+pub struct FirmwareLease {
+    handle: ptr::NonNull<c_void>,
+    bytes: &'static [u8],
+}
+
+impl FirmwareLease {
+    /// Acquires an image from the real installed boot archive, not a Linux host.
+    pub fn acquire(kind: FirmwareKind, family: ChipFamily) -> Result<Self, FirmwareError> {
+        #[cfg(target_os = "none")]
+        if ostd::irq::InterruptLevel::current().is_interrupt_context() {
+            return Err(FirmwareError::InvalidContext);
+        }
+        let expected = image(kind, family)?;
+        let mut data = ptr::null();
+        let mut size = 0;
+        // SAFETY: Valid, distinct output slots. This provider does not
+        // dereference nv_state_t; a successful handle is immediately owned.
+        let handle =
+            unsafe { aster_nv_firmware_acquire(kind as u32, family as u32, &mut data, &mut size) };
+        let handle = ptr::NonNull::new(handle.cast_mut()).ok_or(FirmwareError::NoMemory)?;
+        if data != expected.as_ptr().cast() || size as usize != expected.len() {
+            // SAFETY: This is the exact owned handle and no bytes were exposed.
+            unsafe { aster_nv_firmware_release(handle.as_ptr()) };
+            return Err(FirmwareError::ContractViolation);
+        }
+        Ok(Self {
+            handle,
+            bytes: expected,
+        })
+    }
+
+    /// Exact, immutable firmware file bytes; no signature or GSP boot claim.
+    pub fn as_bytes(&self) -> &[u8] {
+        self.bytes
+    }
+}
+
+impl Drop for FirmwareLease {
+    fn drop(&mut self) {
+        // SAFETY: Unique ownership ensures one release after all borrows end.
+        unsafe { aster_nv_firmware_release(self.handle.as_ptr()) };
+    }
+}
+
+struct Handle {
+    bytes: &'static [u8],
+}
+
+fn raw_filename(kind: u32, family: u32) -> Option<&'static str> {
+    // SAFETY: The bridge validates all raw enum values before the upstream call
+    // and returns a static string, with the empty string meaning invalid input.
+    let path = unsafe { CStr::from_ptr(aster_nv_firmware_path(kind, family)) };
+    let path = path.to_str().ok()?;
+    (!path.is_empty()).then_some(path)
+}
+
+/// RM firmware acquisition ABI. `nv` is not dereferenced: unlike Linux, this
+/// provider has no Linux `struct device` dependency and no per-device fallback.
+///
+/// # Safety
+/// Both output slots must be aligned, writable and nonoverlapping for the call.
+/// Call in task context, never in an interrupt or while holding a spinlock.
+/// On success the handle must be released exactly once by `nv_put_firmware`,
+/// after all foreign accesses to the returned firmware bytes have completed.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nv_get_firmware(
+    _nv: *mut c_void,
+    kind: u32,
+    family: u32,
+    buffer: *mut *const c_void,
+    size: *mut u32,
+) -> *const c_void {
+    if buffer.is_null() || size.is_null() {
+        return ptr::null();
+    }
+    // SAFETY: Caller grants exclusive access to both output slots.
+    unsafe {
+        buffer.write(ptr::null());
+        size.write(0);
+    }
+    #[cfg(target_os = "none")]
+    if ostd::irq::InterruptLevel::current().is_interrupt_context() {
+        return ptr::null();
+    }
+    let Some(path) = raw_filename(kind, family) else {
+        return ptr::null();
+    };
+    let Some(archive) = ARCHIVE.get() else {
+        return ptr::null();
+    };
+    let Ok(bytes) = archive.get_path(path) else {
+        return ptr::null();
+    };
+    let layout = Layout::new::<Handle>();
+    // SAFETY: Nonzero valid layout. Null allocation is reported as failure.
+    let handle = unsafe { alloc(layout) }.cast::<Handle>();
+    if handle.is_null() {
+        return ptr::null();
+    }
+    // SAFETY: New handle is exclusively owned. Archive bytes are static,
+    // nonempty and bounded below u32::MAX by the validated provider.
+    unsafe {
+        handle.write(Handle { bytes });
+        let stored = &*handle;
+        buffer.write(stored.bytes.as_ptr().cast());
+        size.write(stored.bytes.len() as u32);
+    }
+    handle.cast()
+}
+
+/// Releases one actual RM firmware ownership handle; NULL is harmless.
+///
+/// # Safety
+/// `handle` must be NULL or an unreleased handle returned by `nv_get_firmware`.
+/// No foreign accesses associated with this handle may outlive this call.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nv_put_firmware(handle: *const c_void) {
+    if handle.is_null() {
+        return;
+    }
+    let handle = handle.cast_mut().cast::<Handle>();
+    // SAFETY: Caller returns exclusive ownership of the exact live handle.
+    unsafe {
+        ptr::drop_in_place(handle);
+        dealloc(handle.cast(), Layout::new::<Handle>());
+    }
+}
+
+#[cfg(any(test, ktest))]
+mod tests {
+    use alloc::{boxed::Box, format, vec::Vec};
+
+    use super::*;
+
+    fn entry(out: &mut Vec<u8>, name: &str, bytes: &[u8], mode: u32, links: u32) {
+        let fields = [
+            1,
+            mode,
+            0,
+            0,
+            links,
+            0,
+            bytes.len() as u32,
+            0,
+            0,
+            0,
+            0,
+            (name.len() + 1) as u32,
+            0,
+        ];
+        out.extend_from_slice(b"070701");
+        for field in fields {
+            out.extend_from_slice(format!("{field:08x}").as_bytes());
+        }
+        out.extend_from_slice(name.as_bytes());
+        out.push(0);
+        while out.len() % 4 != 0 {
+            out.push(0);
+        }
+        out.extend_from_slice(bytes);
+        while out.len() % 4 != 0 {
+            out.push(0);
+        }
+    }
+    fn finish(out: &mut Vec<u8>) {
+        entry(out, "TRAILER!!!", &[], 0, 1);
+    }
+    fn path() -> &'static str {
+        "lib/firmware/nvidia/615.78.08/gsp_tu10x.bin"
+    }
+
+    #[cfg_attr(test, test)]
+    #[cfg_attr(ktest, ostd::prelude::ktest)]
+    fn upstream_release_and_family_selection() {
+        assert_eq!(
+            filename(FirmwareKind::Gsp, ChipFamily::Tu10x),
+            "nvidia/615.78.08/gsp_tu10x.bin"
+        );
+        assert_eq!(
+            filename(FirmwareKind::Ucodes, ChipFamily::Ga100),
+            "nvidia/615.78.08/ucodes_tu10x.bin"
+        );
+        for family in [
+            ChipFamily::Ga10x,
+            ChipFamily::Ad10x,
+            ChipFamily::Gh100,
+            ChipFamily::Gb10x,
+            ChipFamily::Gb20x,
+            ChipFamily::Gr10x,
+            ChipFamily::Gb10y,
+            ChipFamily::Gb20y,
+        ] {
+            assert_eq!(
+                filename(FirmwareKind::GspLog, family),
+                "nvidia/615.78.08/gsp_log_ga10x.bin"
+            );
+        }
+        for (kind, family) in [(3, 1), (0, 0), (0, 7), (0, 13), (u32::MAX, u32::MAX)] {
+            assert_eq!(raw_filename(kind, family), None);
+        }
+    }
+
+    #[cfg_attr(test, test)]
+    #[cfg_attr(ktest, ostd::prelude::ktest)]
+    fn archive_exact_image_and_no_cross_release_fallback() {
+        let mut bytes = Vec::new();
+        entry(
+            &mut bytes,
+            "lib/firmware/nvidia/615.71.09/gsp_tu10x.bin",
+            &[9],
+            0o100644,
+            1,
+        );
+        entry(&mut bytes, path(), &[1, 2, 3, 4, 5], 0o100644, 1);
+        finish(&mut bytes);
+        let archive = FirmwareArchive::new(&bytes).unwrap();
+        assert_eq!(
+            archive.get(FirmwareKind::Gsp, ChipFamily::Tu10x),
+            Ok(&[1, 2, 3, 4, 5][..])
+        );
+        assert_eq!(
+            archive.get(FirmwareKind::Gsp, ChipFamily::Ga10x),
+            Err(FirmwareError::NotFound)
+        );
+    }
+
+    #[cfg_attr(test, test)]
+    #[cfg_attr(ktest, ostd::prelude::ktest)]
+    fn archive_rejects_every_truncation_and_bad_numeric_header() {
+        let mut bytes = Vec::new();
+        entry(&mut bytes, path(), &[1, 2, 3], 0o100644, 1);
+        finish(&mut bytes);
+        for end in 0..bytes.len() {
+            assert!(FirmwareArchive::new(&bytes[..end]).is_err(), "{end}");
+        }
+        bytes[6] = b'g';
+        assert!(matches!(
