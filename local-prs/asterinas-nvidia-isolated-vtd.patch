+/// An isolated DMA context tied to an exclusively reserved PCI function.
+///
+/// The context borrows the MMIO guard, which borrows the PCI reservation, so a
+/// requester cannot be returned to enumeration while the DMA domain or any of
+/// its buffers remain live. This deliberately bounded implementation accepts
+/// only bus-zero type-0 headers and rejects every PCI Express capability: PCIe
+/// extended capabilities (including ATS/PRI/PASID) have not been reviewed.
+/// Consequently this implementation will not admit modern NVIDIA PCIe GPUs.
+#[cfg(target_arch = "x86_64")]
+pub struct PciIsolatedDmaContext<'a> {
+    inner: IsolatedDmaContext,
+    _owner: PhantomData<&'a ()>,
+}
+
+#[cfg(target_arch = "x86_64")]
+impl<'a> PciIsolatedDmaContext<'a> {
+    /// Builds an isolated domain for the real requester owned by `owner`.
+    ///
+    /// Device lifetime and completion
+    /// The caller must exclusively own this requester, keep bus mastering
+    /// disabled until all buffers are ready, and ensure the device is quiescent.
+    /// The caller must also ensure there are no aliases/bridges or active
+    /// ATS/PRI/PASID paths. The PCI checks below reject known unsupported
+    /// topologies but cannot establish device-specific quiescence.
+    pub(crate) fn new(owner: &'a PciMmioGuard<'_>, mask: DmaMask) -> Result<Self, DeviceDmaError> {
+        let loc = owner.location();
+        if loc.read16(0) == 0xffff {
+            return Err(DeviceDmaError::InvalidRequester);
+        }
+        if loc.bus != 0 || loc.function != 0 || loc.read8(0x0e) != 0 || loc.read8(0x0b) == 0x06 {
+            return Err(DeviceDmaError::UnsupportedPlatform);
+        }
+        if loc.read16(4) & crate::cfg_space::Command::BUS_MASTER.bits() != 0 {
+            return Err(DeviceDmaError::InvalidContext);
+        }
+        validate_conventional_capabilities(loc)?;
+        let requester = PciDmaRequester::new(0, loc.bus, loc.device, loc.function)?;
+        let inner = IsolatedDmaContext::new(requester, mask)?;
+        Ok(Self {
+            inner,
+            _owner: PhantomData,
+        })
+    }
+
+    /// Returns the actual requester identity tied to this domain.
+    pub fn requester(&self) -> &PciDmaRequester {
+        self.inner.requester()
+    }
+
+    /// Returns the inclusive address mask enforced for allocations.
+    pub fn mask(&self) -> &DmaMask {
+        self.inner.mask()
+    }
+
+    /// Allocates zeroed, coherent memory mapped only in this requester's domain.
+    pub fn alloc_coherent(&self, nframes: usize) -> Result<IsolatedDmaBuffer<'_>, DeviceDmaError> {
+        self.inner.alloc_coherent(nframes)
+    }
+
+    /// Returns the hardware isolation-domain identifier.
+    pub fn domain_id(&self) -> u16 {
+        self.inner.domain_id()
+    }
+}
+
+/// Reject malformed conventional capability chains and PCIe functions.
+/// PCIe is conservatively excluded because its extended capability list has
+/// not been audited for requester aliases or translation services.
+#[cfg(target_arch = "x86_64")]
+fn validate_conventional_capabilities(loc: crate::PciDeviceLocation) -> Result<(), DeviceDmaError> {
+    if loc.read16(6) & crate::cfg_space::Status::CAPABILITIES_LIST.bits() == 0 {
+        return Ok(());
+    }
+    let mut pointer = loc.read8(0x34);
+    if pointer == 0 {
+        return Err(DeviceDmaError::InvalidRequester);
+    }
+    let mut visited = 0u64;
+    while pointer != 0 {
+        if !(0x40..=0xfc).contains(&pointer) || pointer & 3 != 0 {
+            return Err(DeviceDmaError::InvalidRequester);
+        }
+        let bit = 1u64 << (pointer / 4);
+        if visited & bit != 0 {
+            return Err(DeviceDmaError::InvalidRequester);
+        }
+        visited |= bit;
+        if loc.read8(u16::from(pointer)) == 0x10 {
+            return Err(DeviceDmaError::UnsupportedPlatform);
+        }
+        pointer = loc.read8(u16::from(pointer) + 1);
+    }
+    Ok(())
+}
