+            );
+        }
+        data[0x41] = 0x40;
+        assert!(capability_offsets(0x40, |o| data[o as usize]).is_none());
+        for ptr in (0x40..0xfc).step_by(4) {
+            data[ptr + 1] = (ptr + 4) as u8;
+        }
