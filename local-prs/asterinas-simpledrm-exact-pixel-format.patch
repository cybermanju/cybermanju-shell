+fn drm_pixel_format_for(framebuffer_format: PixelFormat) -> Result<DrmPixelFormat> {
+    match framebuffer_format {
+        // DRM FourCCs describe component significance, while the boot framebuffer API
+        // describes byte order. On little-endian systems these layouts are equivalent.
+        PixelFormat::BgrReserved => Ok(DrmPixelFormat::XRGB8888),
+        PixelFormat::Rgb888 => Ok(DrmPixelFormat::BGR888),
+        PixelFormat::Grayscale8 | PixelFormat::Rgb565 => {
+            return_errno_with_message!(
+                Errno::EOPNOTSUPP,
+                "the boot framebuffer pixel format has no exact supported DRM layout"
+            );
+        }
+    }
+}
