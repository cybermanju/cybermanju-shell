+/// Construct and connect a PulseAudio context, returning startup failures to
+/// the listener so they can be reflected in the service lifecycle.
+fn initialize_connection(server: Option<&str>) -> Result<(Mainloop, Context), String> {
+    let mut proplist =
+        Proplist::new().ok_or_else(|| "Failed to create PulseAudio proplist".to_owned())?;
+    proplist
+        .set_str(APPLICATION_NAME, "gpuishell")
+        .map_err(|_| "Failed to set PulseAudio application name".to_owned())?;
+
+    let mainloop =
+        Mainloop::new().ok_or_else(|| "Failed to create PulseAudio mainloop".to_owned())?;
+    let mut context = Context::new_with_proplist(&mainloop, "gpuishell", &proplist)
+        .ok_or_else(|| "Failed to create PulseAudio context".to_owned())?;
+    context
+        .connect(server, FlagSet::NOFLAGS, None)
+        .map_err(|error| format!("Failed to connect to PulseAudio: {error:?}"))?;
+
+    Ok((mainloop, context))
+}
