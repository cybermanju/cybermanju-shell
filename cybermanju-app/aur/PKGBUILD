# Maintainer: CyberManju <cybermanju@users.noreply.github.com>
pkgname=cybermanju-os
pkgver=0.1.1
pkgrel=1
pkgdesc="Encrypted file sync and management with post-quantum cryptography"
arch=('x86_64')
url="https://github.com/cybermanju/cybermanju.github.io"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsoup3'
  'openssl'
)
makedepends=(
  'cargo'
  'nodejs'
  'npm'
  'pkg-config'
  'base-devel'
)
# VCS source: a tagged clone, for which 'SKIP' is the correct checksum
# (an unpinned tarball must carry a real sha256 instead).
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  npm ci
}

build() {
  cd "$pkgname"
  npm run tauri build
}

package() {
  cd "$pkgname"

  # Install the binary
  install -Dm755 "target/release/cybermanju-os-desktop" \
    "$pkgdir/usr/bin/cybermanju-os-desktop"

  # Install desktop file
  local desktop_file
  desktop_file=$(find target/release/bundle -name '*.desktop' -type f 2>/dev/null | head -1)
  if [ -n "$desktop_file" ]; then
    install -Dm644 "$desktop_file" \
      "$pkgdir/usr/share/applications/cybermanju-os.desktop"
  fi

  # Install icons
  for size in 32 128 256; do
    local icon="src-tauri/icons/${size}x${size}.png"
    if [ -f "$icon" ]; then
      install -Dm644 "$icon" \
        "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/cybermanju-os.png"
    fi
  done

  # Install license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
