[Global]
name=CyberManju Default
version=1.2
description=Default keyboard & touchpad profile for CyberManju OS

[Global Shortcuts]
toggle_sidebar=Ctrl+B
toggle_palette=Ctrl+P
toggle_help=Ctrl+/
focus_search=Ctrl+F
new_folder=Ctrl+Shift+N
upload_file=Ctrl+U
refresh=Ctrl+R
toggle_dark_mode=Ctrl+D
escape=Escape
toggle_fullscreen=F11

[Navigation]
go_back=Alt+Left
go_forward=Alt+Right
go_up=Alt+Up
go_home=Alt+Home
focus_grid=Ctrl+1
focus_sidebar=Ctrl+2
focus_right_panel=Ctrl+3
focus_search_panel=Ctrl+4
prev_panel=Ctrl+Tab
next_panel=Ctrl+Shift+Tab

[File Operations]
delete=Delete
rename=F2
copy=Ctrl+C
cut=Ctrl+X
paste=Ctrl+V
select_all=Ctrl+A
deselect=Escape
open=Enter
preview=Space
star_file=Ctrl+S
compress=Ctrl+Shift+C
encrypt=Ctrl+Shift+E
download=Ctrl+D
file_properties=Alt+Enter
show_permissions=Ctrl+Shift+P
duplicate=Ctrl+D
rotate_cw=Ctrl+Shift+R
rotate_ccw=Ctrl+Alt+R

[View]
toggle_grid=Ctrl+Shift+1
toggle_list=Ctrl+Shift+2
toggle_masonry=Ctrl+Shift+3
toggle_details=Ctrl+Shift+4
sort_name=Ctrl+Shift+N
sort_date=Ctrl+Shift+D
sort_size=Ctrl+Shift+S
sort_type=Ctrl+Shift+T
toggle_hidden=Ctrl+H
zoom_in=Ctrl+=
zoom_out=Ctrl+-

[Panels]
open_trash=Ctrl+T
open_activity=Ctrl+Shift+A
open_collections=Ctrl+Shift+O
open_faces=Ctrl+Shift+F
open_map=Ctrl+Shift+M
open_code=Ctrl+Shift+K
open_settings=Ctrl+,
open_storage=Ctrl+Shift+S
open_favorites=Ctrl+Shift+F
open_terminal=Ctrl+`
open_editor=Ctrl+E
open_agent=Ctrl+G

# ── Window management ──────────────────────────────────────────
# Primary bindings are Tauri-first. In a browser (WASM/Pages) Ctrl+T,
# Ctrl+W and Ctrl+Tab are owned by the browser chrome and can NEVER be
# intercepted (preventDefault is ignored) — the shell auto-registers the
# Alt+ fallback next to each of them, so Alt+T / Alt+W / Alt+[ always work.
[Windows]
close_window=Alt+W
close_window_alt=Ctrl+W
minimize_window=Alt+M
maximize_toggle=Alt+F
focus_window=Alt+Tab
focus_next=Alt+]
focus_prev=Alt+[
focus_next_alt=Ctrl+Tab
focus_prev_alt=Ctrl+Shift+Tab
tile_left=Alt+Left
tile_right=Alt+Right
tile_top=Alt+Up
tile_bottom=Alt+Down
move_window_left=Alt+Shift+Left
move_window_right=Alt+Shift+Right
move_window_up=Alt+Shift+Up
move_window_down=Alt+Shift+Down
cascade_windows=Alt+C
autotile_toggle=Alt+T
autotile_toggle_alt=Ctrl+T

[Workspace]
strip_left=Ctrl+Alt+Left
strip_right=Ctrl+Alt+Right
strip_up=Ctrl+Alt+Up
strip_down=Ctrl+Alt+Down
overview_toggle=Alt+O
layout_floating=Alt+1
layout_tiled=Alt+2
layout_strip=Alt+3
layout_overview=Alt+4
strip_direction=Alt+D
close_all_windows=Alt+Shift+W
minimize_all=Alt+Shift+M

[Plasma]
kickoff_toggle=Alt+F1
runner_toggle=Alt+Space
runner_toggle_alt=Ctrl+Space
task_switch=Alt+Tab
snap_left=Meta+Left
snap_right=Meta+Right
snap_up=Meta+Up
snap_down=Meta+Down

[Touch]
swipe_threshold=50
long_press_threshold=600
edge_zone_size=30
double_tap_timeout=300
auto_detect_touch=true
